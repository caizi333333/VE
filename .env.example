# 复制到 .env.local，真实密钥不写入源码或共享材料。
DATABASE_URL="file:./dev.db"

# qianfan | spark | glm。供应商、模型和数据处理条件由学校确认。
# 不配密钥时提交仍保留，由教师人工处理。
LLM_PROVIDER=glm
QIANFAN_API_KEY=
QIANFAN_MODEL=ernie-4.5-turbo-128k
SPARK_API_KEY=
SPARK_MODEL=generalv3.5
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# HTTPS 部署设为 true；本地 HTTP 演示保持 false。
SECURE_COOKIES=false
# 教师账号通过 npm run teacher:create 建立，班级码不是教师口令。
